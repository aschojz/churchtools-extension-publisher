        "@churchtools/churchtools-client": "^1.6.0",
        "@churchtools/utils": "file:../churchtools/frontend-packages/utils",
        "@churchtools/vue-query": "file:../churchtools/frontend-packages/vue-query",
        "@fortawesome/fontawesome-svg-core": "^7.3.1",
        "@fortawesome/free-solid-svg-icons": "^7.3.1",
        "@fortawesome/vue-fontawesome": "^3.3.3",
        "@tanstack/vue-query": "^5.101.4",
        "konva": "^10.3.0",
        "vue": "^3.5.40",
        "vue-konva": "^3.4.0"
    },
    "devDependencies": {
        "@types/node": "^24.3.0",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/test-utils": "^2.4.11",
        "jsdom": "^30.0.1",
        "typescript": "^5.9.2",
        "vite": "^7.1.2",
        "vitest": "^4.1.10",
        "vue-tsc": "^3.0.6"
